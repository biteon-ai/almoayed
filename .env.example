# Al-Moayed — local environment template
# Copy: cp .env.local.example .env.local

# ── Supabase ──────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ── Session (iron-session) — min 32 characters ────────────────
SESSION_SECRET=complex_password_at_least_32_characters_long_dev_only

# ── App ───────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_TEACHER_WHATSAPP=963999999999

# ── BiteonSwitch OTP (AUTH-001) ───────────────────────────────
BITEONSWITCH_API_KEY=
BITEONSWITCH_APP_ID=
BITEONSWITCH_CALLBACK_URL=http://localhost:3000/api/auth/biteonswitch/callback
BITEONSWITCH_HOSTED_LOGIN_URL=
BITEONSWITCH_API_BASE_URL=
# Local/dev without live provider: mock verify via token mock:<whatsapp>
BITEONSWITCH_MOCK=true

# ── Admin fallback (AUTH-005) ─────────────────────────────────
ADMIN_FALLBACK_SECRET=
# Alias also accepted: ADMIN_FALLBACK_KEY / ADMIN_SECRET
ADMIN_FALLBACK_KEY=
# Comma-separated WhatsApp numbers (digits) allowed for /admin/login
ADMIN_WHATSAPP_ALLOWLIST=963912345678

# ── Demo one-click login (AUTH / local) ───────────────────────
# true = enable; false = disable; unset = enabled when NODE_ENV !== production
AUTH_DEMO_BYPASS=true
