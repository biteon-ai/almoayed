# Al-Moayed — local environment template
# Copy: cp .env.example .env

# ── Supabase ──────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ── Session (iron-session) — min 32 characters ────────────────
SESSION_SECRET=complex_password_at_least_32_characters_long_dev_only

# ── App ───────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_TEACHER_WHATSAPP=963999999999

# ── BiteonSwitch OTP (AUTH-001) ───────────────────────────────
BITEONSWITCH_API_KEY=
BITEONSWITCH_APP_ID=
BITEONSWITCH_CALLBACK_URL=http://localhost:3000/api/auth/biteonswitch/callback
# Production (Vercel): set to your live BiteonSwitch hosted login base — NOT localhost
BITEONSWITCH_HOSTED_LOGIN_URL=
BITEONSWITCH_API_BASE_URL=
# Local/dev without live provider: mock verify via token mock:<whatsapp>
BITEONSWITCH_MOCK=true

# ── Admin fallback (AUTH-005) ─────────────────────────────────
ADMIN_FALLBACK_SECRET=
# Alias also accepted: ADMIN_FALLBACK_KEY / ADMIN_SECRET
ADMIN_FALLBACK_KEY=
# Comma-separated WhatsApp numbers (digits) allowed for /admin/emergency
ADMIN_WHATSAPP_ALLOWLIST=963912345678

# ── Super Admin (ADMIN-001) ───────────────────────────────────
SUPER_ADMIN_EMAIL=admin@almoayed.local
SUPER_ADMIN_PASSWORD=change-me-in-production

# ── Demo one-click login (AUTH / local) ───────────────────────
# true = show تجربة tab + enable demos; false = hide tab (also default in production)
# unset = enabled when NODE_ENV !== production
AUTH_DEMO_BYPASS=true

# ── Performance stress suite (PERF-TEST-001) ──────────────────
# Required for /api/perf/probe and npm run test:stress / test:perf
PERF_TEST_SECRET=local-perf-secret-change-me
# Optional overrides:
# PERF_BASE_URL=http://localhost:3000
# PERF_VUS=20
# PERF_DURATION=30s
# PERF_SKIP_K6=1
# PERF_SKIP_LIGHTHOUSE=1
